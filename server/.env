# TGDesk — servidor central (Fase 0)
# Copie para .env e ajuste antes de subir o docker-compose.

JWT_SECRET=e9345d437a88c13727ca1bdca12a5a12a0d0e1ead93b2c08e00c0fa2c74aaf7c

# Organizações/redes de demonstração criadas no boot (opcional).
# Formato: OrgNome:Rede1|Rede2;OutraOrg:Rede1
SEED_ORGANIZATIONS=
ENABLE_DEMO_SEED=false

# Contas técnicas provisionadas no boot.
# Formato: usuario:senha:papel (papel = super_admin ou tecnico), separadas por vírgula.
TECH_USERS=

# Atribuições de escopo para contas "tecnico".
# Formato: usuario:OrgNome[:RedeNome], separadas por vírgula.
TECH_ASSIGN=

# Se true, reseta a senha/papel de usuários já existentes no próximo boot.
FORCE_RESEED=false

# Endpoint público do hub WireGuard (IP público:porta UDP com port-forward)
HUB_PUBLIC_ADDR=168.232.199.161:41820
CLIENT_VERSION=1.2.24

FROM golang:1.22-alpine AS build
WORKDIR /src
COPY api-core/go.mod api-core/go.sum ./
RUN go mod download
COPY api-core/ .
RUN CGO_ENABLED=0 go build -o /out/api-core ./cmd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates iproute2 wireguard-tools
WORKDIR /app
COPY --from=build /out/api-core ./api-core
COPY migrations ./migrations
RUN mkdir -p ./releases
EXPOSE 8080
ENTRYPOINT ["./api-core"]
